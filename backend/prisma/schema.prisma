generator client {
  provider = "prisma-client-js"
}

// Conectado a Supabase (PostgreSQL)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Producto {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique @db.VarChar(50)
  rubro       String?  @db.VarChar(50)
  costo       Decimal? @db.Decimal(9, 2)
  precio1     Decimal  @map("precio_1") @db.Decimal(9, 2)
  precio2     Decimal? @map("precio_2") @db.Decimal(9, 2)
  precio3     Decimal? @map("precio_3") @db.Decimal(9, 2)
  creado      DateTime @default(now()) @db.Date
  modificado  DateTime? @db.Date
  proveedorId Decimal? @map("proveedor_id") @db.Decimal

  @@map("producto")
}
