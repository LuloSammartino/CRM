generator client {
  provider = "prisma-client-js"
}

// Conectado a Supabase (PostgreSQL)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Producto {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique @db.VarChar(50)
  rubro       String?  @db.VarChar(50)
  costo       Decimal? @db.Decimal(9, 2)
  precio1     Decimal  @map("precio_1") @db.Decimal(9, 2)
  precio2     Decimal? @map("precio_2") @db.Decimal(9, 2)
  precio3     Decimal? @map("precio_3") @db.Decimal(9, 2)
  creado      DateTime @default(now()) @db.Date
  modificado  DateTime? @db.Date
  proveedorId Decimal? @map("proveedor_id") @db.Decimal

  @@map("producto")
}

model Cliente {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique @db.VarChar(50)
  direccion   String? @db.VarChar(50)
  direccion1  String? @map("direccion_1") @db.VarChar(50)
  direccion2  String? @map("direccion_2") @db.VarChar(50)
  telefono    String? @db.VarChar(30)
  email       String? @map("e_mail") @db.VarChar(50)
  cuit        String? @db.VarChar(11)
  iva         String? @db.VarChar(30)
  tipo        String? @db.VarChar(40)
  razonSocial String? @map("razon_social") @db.VarChar(60)

  @@map("clientes")
}
