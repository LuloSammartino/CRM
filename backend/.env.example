# Supabase Postgres connection string.
# Shared pooler transaction mode uses:
# postgresql://postgres.<project-ref>:<database-password>@aws-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.<project-ref>:<database-password>@aws-<region>.pooler.supabase.com:6543/postgres"

# Supabase API values, only needed if the backend uses Supabase APIs directly.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

PORT=4000
NODE_ENV=development
